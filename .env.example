# ntfy.sh push notifications — free, no account needed
# 1. Install the ntfy app on your phone (iOS or Android)
# 2. Pick any unique topic name (like "viraj-yourname") and subscribe to it in the app
# 3. Paste the same topic name below
NTFY_TOPIC=viraj-yourname
NTFY_SERVER=https://ntfy.sh   # or self-host; leave as-is for the free public server

# Anthropic — optional, only needed for `agent ask`
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Schedule (24h format, default = 8:00 AM)
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=0

# Your timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Chicago
