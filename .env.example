# Twilio — sign up free at https://twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # your Twilio phone number
USER_PHONE=+1XXXXXXXXXX           # your personal phone number

# Anthropic — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Schedule (24h format, default = 8:00 AM)
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=0

# Your timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Chicago
